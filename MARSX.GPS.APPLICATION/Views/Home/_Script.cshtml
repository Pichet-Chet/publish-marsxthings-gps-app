    async function rerverseGeocoding(param) {

        var result = '';

        var filter = new Object();

        filter.lat = param.lat;
        filter.lon = param.lon;

        await $.ajax({
            type: "Get",
            contentType: "charset=utf-8",
            data: filter,
            url: '@Url.Action("rerverseGeocoding", "LongdoMap")',
            success: function (resp) {

                if (resp.status == true) {

                    var location = resp.data;

                    result = location.road + " " + location.subdistrict + " " + location.district + " " + location.province + " " + location.postcode + " " + "(" + location.country + ")";
                }

            }
        });

        return result;
    }

