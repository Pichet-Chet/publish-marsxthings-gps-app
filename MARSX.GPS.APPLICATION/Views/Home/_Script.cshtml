    function redirectToDeviceInformation(param) {

        $('.offcanvas-backdrop').remove()

        if (window.innerWidth <= 768) {
            $('#menu-device').offcanvas('hide');

            $('#menu-device').css({ 'z-index': 1 });
        }
        else {
            $('#menu-device').offcanvas('show');

            $('#menu-device').css({ 'z-index': 999 });
        }

        $('#device-detail-canvas').offcanvas('show');

        $('#device-detail-canvas').css({ 'z-index': 999 });

        $('.offcanvas-backdrop').css({
            opacity: 0,
            position: 'relative'
        })

        var decodeParameter = decodeURIComponent(param)

        var obj = JSON.parse(decodeParameter);

        $.ajax({
            type: "POST",
            data: JSON.stringify(obj),
            dataType: 'text',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("Index", "DeviceInfo")',
            success: function(data) {
                $('#render-device-detail-canvas').html(data);
                $('#preloader').remove();
            }
        })
        .fail(function (jqXHR, textStatus, errorThrown) {
            console.log("AJAX request failed:" + textStatus + errorThrown);
        // Add code to handle the failure, such as displaying an error message
        $('#preloader').remove(); // Remove preloader if it was not removed on success
        });

    }

    function getCurrentLocation(tlat,tlon) {

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                var latitude = position.coords.latitude;
                var longitude = position.coords.longitude;

                var parameterRouteGuide = `mode=c&type=1&flon=${longitude}&flat=${latitude}&tlon=${tlon}&tlat=${tlat}&key=` + '@Model.longdoMapKey.ToString()';

                var settings = {
                    "url": "https://api.longdo.com/RouteService/json/route/guide?" + parameterRouteGuide,
                    "method": "GET",
                    "timeout": 0,
                };

                $.ajax(settings).done(function (response) {

                    var calDistance = response.data[0].distance / 1000;
                    calDistance = '' + calDistance.toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, '$1,') + " KM.";

                    var calInterval = '' + secondsToHms(response.data[0].interval);

                    $('#map-deatil-distance').html(`${calDistance}`)
                    $('#map-deatil-interval').html(`${calInterval}`)
                });

            }, function (error) {
                // Handle errors
                switch (error.code) {
                    case error.PERMISSION_DENIED:

                        $('#ui-block').offcanvas("hide");

                        toastError("Error", "User denied the request for Geolocation.");
                        fnBlockScreenGps("");
                        clearPassCodeValue()
                        break;
                    case error.POSITION_UNAVAILABLE:
                        $('#ui-block').offcanvas("hide");
                        toastError("Error", "Location information is unavailable.");
                        fnBlockScreenGps(" or Location information is unavailable.");
                        clearPassCodeValue()
                        break;
                    case error.TIMEOUT:
                        $('#ui-block').offcanvas("hide");
                        toastError("Error", "The request to get user location timed out.");
                        fnBlockScreenGps("or The request to get user location timed out.");
                        clearPassCodeValue()
                        break;
                    case error.UNKNOWN_ERROR:
                        $('#ui-block').offcanvas("hide");
                        toastError("Error", "An unknown error occurred.");
                        fnBlockScreenGps("or An unknown error occurred.");
                        clearPassCodeValue()
                        break;
                }

            });
        } else {
            fnBlockScreenError("Error", "Something's not right. Geolocation is not supported by this browser.");
        }

    }

    function secondsToHms(seconds) {
        var hours = Math.floor(seconds / 3600);
        var minutes = Math.floor((seconds % 3600) / 60);
        var seconds = Math.floor(seconds % 60);

        var timeString = '';
        if (hours > 0) {
            timeString += (hours < 10 ? '' : '') + hours + ' Hours ';
        }
        timeString += (minutes < 10 ? '0' : '') + minutes + ' Minute ';

        return timeString;
    }


