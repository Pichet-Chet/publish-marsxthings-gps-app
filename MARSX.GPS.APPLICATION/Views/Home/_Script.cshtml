@model MARSX.GPS.APPLICATION.Models.Customs.UserInfo

<script type="text/javascript" src="https://api.longdo.com/map3/?key=@Model.longdoMapKey.ToString()"></script>

<script type="text/javascript">

    var objLatLon = [];

    var map;

    var currentLanguage;

    var defaultScreenHeight;

    var setMapHeight;

    //var connection;

    var currentDate = new Date();

    let setNewId = null;

    var socketUserOnline;

    var socketDeviceDetail;

    $(document).ready(function () {

        initMap();

        getDeviceListOnMap();

        onGetCookie();

        defaultScreenHeight = $(window).height();

        setMapHeight = (defaultScreenHeight + (defaultScreenHeight * 10 / 100));

        $("#mapRender").css({ 'height': setMapHeight + 'px', 'min-height': defaultScreenHeight + 'px' });
    })

    document.addEventListener('DOMContentLoaded', function () {
        setTimeout(function () {

            $('.maplibregl-control-container').addClass("d-none");
            $('.mapboxgl-control-container').css("display", "none");

        }, 1000);

        socketUserOnline = new signalR.HubConnectionBuilder()
            .withUrl("/SignalROnlineUser")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        socketUserOnline.start().then(function () {
                //console.log("SignalR Connected");
            }).catch(function (err) {
            //console.log("SignalR Connection Error: " + err.toString());
        });

        function getOnlineUserCount() {

            if (socketUserOnline.state === 'Connected') {

                socketUserOnline.invoke("GetOnlineUserCount").then(function (onlineUserCount) {

                    $('span#user-online-count').text(`${onlineUserCount}`)

                }).catch(function (err) {
                    //console.error("Error getting online user count:", err.toString());
                });
            } else {

                //console.warn("Connection is not in the 'Connected' state.");

                socketUserOnline.start().then(function () {
                    //console.log("SignalR Connected");
                }).catch(function (err) {
                    //console.log("SignalR Connection Error: " + err.toString());
                });
            }
        }

        // Call getOnlineUserCount initially and every 5 seconds
        getOnlineUserCount();

        setInterval(getOnlineUserCount, 1000); // Update every 5 seconds

    });


    function initMap() {

        currentLanguage = sessionStorage.getItem('currentLanguage');

        map = new longdo.Map({
            layer: longdo.Layers.Longdo,
            placeholder: document.getElementById('map')
            //ui: longdo.UiComponent.Full,
            //language: currentLanguage
        });



        map.Route.placeholder(document.getElementById('result'));

        map.Event.bind('ready', function () { // When map is ready to use
            mapUiControl();
        });

    }

    $('#menu-device').on('hidden.bs.offcanvas', function () {

        $('#section-home-search').addClass('home-search');

        $('#section-home-search').removeClass('home-search-desktop');
        $('#section-home-search').removeClass('home-search-mobile');

    });


    $('#map-detail-canvas').on('hidden.bs.offcanvas', function () {

        socketDeviceDetail.stop()
            .then(function () {
                console.log("SignalR connection stopped successfully.");
                // Nullify the reference to the connection object
                socketDeviceDetail = null;
                console.log("SignalR connection object removed.");
            })
            .catch(function (err) {
                console.error("Error stopping SignalR connection:", err);
            });


    });


    function getDeviceListOnMap() {

        var filter = new Object();

        filter.isAll = true;
        filter.id = $('#inputSearchId').val();
        filter.textSearch = $('#homeInputSearchDevice').val();
        //filter.masterGpsProviderId = 2;

        var getTagAction = $('#tagAction').val();

        if (getTagAction != null && getTagAction != "") {

            filter.TagAction = getTagAction;
        }

        $.ajax({
            type: "Get",
            contentType: "charset=utf-8",
            data: filter,
            url: '@Url.Action("Get", "MasterDevice")',
            success: function (resp) {

                if (resp.effectRow > 0) {

                    map.Overlays.clear();

                    const getDisplayFirstLoad = $('#display-first-load').val();

                    resp.data.forEach((item) => {

                        if (getDisplayFirstLoad != "true") {

                            var newObj = { lat: item.lat, lon: item.lon };

                            objLatLon.push(newObj);

                            setDeviceListSidebar(item);
                        }


                        var setDeviceCount = item.tagDevice == null ? "N/A" : item.tagDevice.tagCount;
                        var setDeviceOnline = item.tagDevice == null ? "N/A" : item.tagDevice.tagOnline;
                        var setDeviceStart = item.tagDevice == null ? "N/A" : item.tagDevice.tagStart;

                        var setDeviceWorking = item.tcAttributesView == null ? false : item.tcAttributesView.ignition == null ? false : item.tcAttributesView.ignition;
                        var setDeviceGps = item == null ? "offline" : item.gpsStatus == null ? "offline" : item.gpsStatus;


                        $('span#tagDeviceCountMobile').text(`${setDeviceCount}`);
                        $('span#tagDeviceOnlineMobile').text(`${setDeviceOnline}`);
                        $('span#tagDeviceStartMobile').text(`${setDeviceStart}`);

                        $('span#tagDeviceCountSpan').text(`${setDeviceCount}`);
                        $('span#tagDeviceOnlineSpan').text(`${setDeviceOnline}`);
                        $('span#tagDeviceStartSpan').text(`${setDeviceStart}`);

                        if (item != null) {

                            if (item.lat != null && item.lon != null) {

                                var getImage = verifyImage(item);

                                var jsonString = JSON.stringify(item);

                                var setAsParameter = encodeURIComponent(jsonString);

                                if (resp.effectRow == 1) {

                                    map.location({ lon: item.lon, lat: item.lat }, true);

                                    map.zoom(17, true);

                                    var marker = new longdo.Marker({ lon: item.lon, lat: item.lat },
                                        {
                                            title: `${item.name}`,
                                            icon: {
                                                html: `<image onclick="verifyHtmlInfo('${setAsParameter}')" src="${getImage}" width="35" />`,
                                                offset: { x: 0, y: -20 }
                                            }
                                        });

                                    map.Overlays.add(marker);

                                }

                                else {
                                    var marker = new longdo.Marker({ lon: item.lon, lat: item.lat },
                                        {
                                            title: `${item.name}`,
                                            icon: {
                                                html: `<image id="${item.id}" gps="${setDeviceGps}" working="${setDeviceWorking}" name"pin" class="" onclick="verifyHtmlInfo('${setAsParameter}')" src="${getImage}" width="50" /> <div name="ringring" id="${item.id}-ringring" class=""></div> <div name="pincircle" id="${item.id}-circle" class=""></div>`,
                                                offset: { x: 0, y: 0 }
                                            }
                                        });

                                    map.Overlays.add(marker);
                                }
                            }
                        }
                    })

                    $('#display-first-load').val("true")

                    $('#inputSearchId').val(null);

                    $('#ui-block').offcanvas('hide');
                }
                else {
                    map.Overlays.clear();

                    $('#ui-block').offcanvas('hide');
                }

                //getDeviceListOnMap();
            }
        });

        $('.maplibregl-control-container').addClass("d-none");
        $('.mapboxgl-control-container').css("display", "none");
    }

    function setDeviceListSidebar(item) {

        var iconDevice = item.masterDeviceCategory == null ? "" : verifyCategory(item.masterDeviceCategory.nameEn);
        var iconStatus = verifyStatus(item.gpsStatus);
        var iconEngine = item.tcAttributesView == null ? verifyEngineDevice("") : item.tcAttributesView.ignition == null ? verifyEngineDevice("") : verifyEngineDevice(item.tcAttributesView.ignition);
        var textModel = verifyModel(item.model);
        var textIsFavorite = verifyIsFavorite(item.id,item.isFavorite)
        //var textImage = item.masterDeviceCategory == null ? verifyImageDevice("") : verifyImageDevice(item.masterDeviceCategory.nameEn);

        var enCodeName = encodeURIComponent(item.name);

        render = `<div role="button" id="record" listdeviceid="${item.id}" onclick="onfocusLatLon(${item.id},${item.lon},${item.lat})">

                    <div class="d-flex px-2 pb-2 pt-2">

                        <div style="margin-top: 10px;">
                            <div onclick="favoriteDevice(${item.id})">
                                ${textIsFavorite}
                            </div>
                        </div>

                        <div class="d-none" id="setLocation">[${item.id},${item.lat},${item.lon}]</div>
                        <div class="d-none" id="setIsFavorite">#isFavorite=${item.isFavorite}</div>

                        <div class="ps-2 align-self-center">
                            <h5 class="ps-1 mb-0 line-height-xs pt-1 font-12" id="name">
                                ${item.name}
                            </h5>
                            <span class="d-none"> ${item.serialNo} ${item.chassis} </span>
                            <h6 class="ps-1 mb-0 font-400 opacity-100 font-9">
                                <i class="${iconStatus} opacity-80" style=" border-radius: 5px;"> GPS</i>
                                <i class="${iconEngine} font-18"></i>
                                ${textModel}
                            </h6>
                        </div>
                        <div class="ms-auto">
                            <div onclick="gotoLatLon(${item.id},${item.lon},${item.lat},'${enCodeName}')" data-bs-toggle="dropdown" class="icon icon-m ps-3">
                                <i role="button" class="ti ti-zoom-scan text-white font-20" style="background-color:#4A89DC;border-radius: 5px;vertical-align:-webkit-baseline-middle;box-shadow:2px 4px 8px rgb(0 27 255 / 65%)"></i>
                            </div>
                        </div>
                    </div>
                </div>`;

        

        if (item.isFavorite == 'true' || item.isFavorite == true) {

            var homeSearch = `<div class="btn button-favorite-device-home mt-2" onclick="onfocusLatLon(${item.id},${item.lon},${item.lat})">
                                <i class="bi bi-star-fill color-yellow-dark"></i>
                                <span>${item.name}</span>
                            </div>`;


            //$('#render-favorite-device-home').append(homeSearch);

            $('#deviceFovariteList').append(render);

            $('#deviceList').append(render);
        }
        else {
            $('#deviceList').append(render);
        }


    }

    function favoriteDevice(id) {

        console.log(id);


        var param = setParameterIsFavorite(id);

        var isFavorite = $('#device-favorite-' + id).attr('attr-' + id + '-favorite');

        var urlAction = '';

        if (isFavorite === 'true' || isFavorite === true) {

            console.log("true : "+ id);

            $('#deviceFovariteListZone #deviceFovariteList #device-favorite-' + id).removeClass("color-yellow-dark");
            $('#deviceFovariteListZone #deviceFovariteList #device-favorite-' + id).addClass("color-gray-dark");
            $('#deviceFovariteListZone #deviceFovariteList #device-favorite-' + id).attr('attr-' + id + '-favorite', false);

            $('#device-favorite-' + id).removeClass("color-yellow-dark");
            $('#device-favorite-' + id).addClass("color-gray-dark");
            $('#device-favorite-' + id).attr('attr-' + id + '-favorite', false);

            //$('#deviceFovariteListZone #deviceFovariteList [listdeviceid=' + id + ']').remove()

            //$('#deviceList').append($('##deviceFovariteListZone #deviceFovariteList [listdeviceid=' + id + ']'))

            urlAction = '@Url.Action("Delete", "SysDeviceFavorite")';

        }
        else {
            console.log("false : " + id);

            $('#deviceFovariteListZone #deviceFovariteList #device-favorite-' + id).removeClass("color-gray-dark");
            $('#deviceFovariteListZone #deviceFovariteList #device-favorite-' + id).addClass("color-yellow-dark");
            $('#deviceFovariteListZone #deviceFovariteList #device-favorite-' + id).attr('attr-' + id + '-favorite', true);

            $('#device-favorite-' + id).removeClass("color-gray-dark");
            $('#device-favorite-' + id).addClass("color-yellow-dark");
            $('#device-favorite-' + id).attr('attr-' + id + '-favorite', true);

            $('#deviceFovariteListZone #deviceFovariteList').append($('#deviceList [listdeviceid='+ id +']'))

            urlAction = '@Url.Action("Create", "SysDeviceFavorite")';

        }

        $.ajax({
            url: urlAction,
            data: param,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {

                if (data.status == true) {

                }
                else {

                    toastError(data.type, data.message);

                }

            },
            fail: function () {
                toastError("Internal Server", "Please contact administrator.")
            }
        });

    }


    function setParameterIsFavorite(id) {

        var data = new Object();

        data.id = 0;
        data.DeviceId = id;

        return data;

    }



    function mapUiControl() {


        map.Ui.Zoombar.visible(false);
        map.Ui.DPad.visible(false);
        map.Ui.Geolocation.visible(false);
        map.Ui.Toolbar.visible(false);
        map.Ui.LayerSelector.visible(false);
        map.Ui.Fullscreen.visible(false);
        map.Ui.Crosshair.visible(false);
        map.Ui.Scale.visible(false);
        map.Ui.Crosshair.visible(false);
        map.Ui.Terrain.visible(false);

        map.Layers.setBase(longdo.Layers.EASY);

        //map.Layers.add(longdo.Layers.TRAFFIC);
        map.Overlays.load(longdo.Overlays.cameras); // Show Cameras overlay
        map.Overlays.load(longdo.Overlays.events); // Show Events overlay

        $('.ldmap_notice').addClass("d-none");
        $('.ldmap_placeholder .ldmap_bottomright').addClass("d-none");


        var flagUk = '@Url.Content("~/customs/flag/country/flag-united-kingdom.png")';
        var flagThai = '@Url.Content("~/customs/flag/country/flag-thailand.png")';



        if (currentLanguage == 'th') {

            $('#flagCountryMap').attr('src', `${flagThai}`);

        } else if (currentLanguage == 'en') {

            $('#flagCountryMap').attr('src', `${flagUk}`);

        }

        map.zoom(7, true);

    }


    function onWebSocket(param) {

        var socket = new WebSocket(param.ws);

        // Event handlers remain the same
        socket.addEventListener('open', (event) => {
            console.log('WebSocket connection opened:', event);
            socket.send('Hello, server!');
        });

        socket.addEventListener('message', (event) => {
            console.log('Message from server:', event.data);
        });

        socket.addEventListener('close', (event) => {

            toastError("WebSocket Close" , "Can't connect to websocket");
        });

        socket.addEventListener('error', (event) => {
            toastError("WebSocket Error", "Can't connect to websocket");
        });

    }

