    function verifyHtmlInfo(param) {

        var decodeParameter = decodeURIComponent(param)

        var obj = JSON.parse(decodeParameter);

        onSocketDeviceDetail(obj.id)


        var engineStatus = `<i class="ti ti-settings-question text-warning"></i>`;
        var batteryPercentage = `<div class="progress-bar gradient-green text-start ps-3 font-600 font-10" role="progressbar"style="width: 0%"></div>`;
        var batteryPercentageText = `N/A`;

        var fuelIcon = `<span class="icon icon-l rounded-m gradient-red shadow-bg shadow-bg-xs" style="padding-top:5px;"><i class="ti ti-gas-station font-24 color-white"></i></span>`;
        var fuelPercent = `<div class="progress-bar gradient-red text-start ps-3 font-600 font-10" role="progressbar"style="width: 0%"></div>`;
        var fuelText = `N/A`;

        var odometer = `N/A`;
        var hours = `N/A`;
        var readMore = `<a onclick="toastError('Sorry', 'this function has been under construction.')" translate="yes" class="btn btn-full btn-xxs gradient-blue">Read more.</a>`;

        var distance = `Distance : N/A`;
        var interval = `Interval : N/A`;


        var findImageBanner = verifyImageBanner(obj)

        var defaultImage = `<img src="${findImageBanner}" class="preload-img img-fluid rounded-l" alt="img" style="max-height:150px;max-width:150px">`;


        obj.id = obj.name == null ? null : obj.id;
        obj.name = obj.name == null ? "N/A" : obj.name;
        obj.model = obj.model == null ? "N/A" : obj.model;
        obj.address = obj.address == null ? "N/A" : obj.address;
        obj.contact = obj.contact == null ? "N/A" : obj.contact;
        obj.phone = obj.phone == null ? "N/A" : obj.phone;
        obj.description = obj.description == null ? "" : obj.description;
        obj.modelYear = obj.modelYear == null ? "" : `( ${obj.modelYear} )`;

