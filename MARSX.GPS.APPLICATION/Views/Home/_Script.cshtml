    function getRoute() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(showPosition, showError);
        } else {
            toastError("Error","Geolocation is not supported by this browser.");
        }
    }

    function showPosition(position) {

        var validatePosition = false;

        var getTargetLat = $('#map-deatil-lat').text();

        var getTargetLon = $('#map-deatil-lon').text();

        validatePosition = getTargetLat == null ? false : getTargetLat == "" ? false : true;

        validatePosition = getTargetLon == null ? false : getTargetLon == "" ? false : true;

        validatePosition = position.coords.latitude == null ? false : position.coords.latitude == "" ? false : true;

        validatePosition = position.coords.longitude == null ? false : position.coords.longitude == "" ? false : true;

        if (validatePosition == true) {

            var paramStr = `?startLat=${position.coords.latitude}&startLon=${position.coords.longitude}&endLat=${getTargetLat}&endLon=${getTargetLon}`

            var urlRoute = '@Url.Content("~/MapRoute")' + paramStr;

            window.location.href = urlRoute;

        }

    }

    function showError(error) {
        switch (error.code) {
            case error.PERMISSION_DENIED:
                console.log("Error", "User denied the request for Geolocation.");
                break;
            case error.POSITION_UNAVAILABLE:
                console.log("Error", "Location information is unavailable.");
                break;
            case error.TIMEOUT:
                console.log("Error", "The request to get user location timed out.");
                break;
            case error.UNKNOWN_ERROR:
                console.log("Error", "An unknown error occurred.");
                break;
        }
    }


