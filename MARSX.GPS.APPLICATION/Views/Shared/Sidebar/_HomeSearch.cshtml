<script type="text/javascript">


    function onHomeFilter() {
        $('#txtSearchDevices').val($('#homeInputSearchDevice').val());


        onFilter();
    }

    function onFilterIsFavorite() {

        $('#txtSearchDevices').val("#isFavorite=true");

        $('#homeInputSearchDevice').css("color", "white");

        onFilter();
    }

    function getMyLocation() {


        $('#ui-block-text').offcanvas('show');

        var latitude;

        var longitude;

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {

                latitude = position.coords.latitude;

                longitude = position.coords.longitude;

                map.location({ lon: longitude, lat: latitude }, true);

                

                setTimeout(function () {

                    var marker = new longdo.Marker({ lon: longitude, lat: latitude },
                        {
                            title: 'Your current here.',
                            icon: {
                                html: `<div class="pulsating-ringring-current"> </div> <div class="pulsating-circle-current"></div> `,
                                offset: { x: 0, y: 0 }
                            }
                        });

                    map.Overlays.add(marker);

                    map.zoom(17, true);

                    $('#ui-block-text').offcanvas("hide");
                    // Your code here
                }, 3500);

            }, function (error) {

                // Handle errors
                switch (error.code) {
                    case error.PERMISSION_DENIED:
                        $('#ui-block-text').offcanvas("hide");
                        toastError("Error", "User denied the request for Geolocation.");
                        fnBlockScreenGps("");
                        break;
                    case error.POSITION_UNAVAILABLE:
                        $('#ui-block-text').offcanvas("hide");
                        toastError("Error", "Location information is unavailable.");
                        fnBlockScreenGps(" or Location information is unavailable.");
                        break;
                    case error.TIMEOUT:
                        $('#ui-block-text').offcanvas("hide");
                        toastError("Error", "The request to get user location timed out.");
                        fnBlockScreenGps("or The request to get user location timed out.");
                        break;
                    case error.UNKNOWN_ERROR:
                        $('#ui-block-text').offcanvas("hide");
                        toastError("Error", "An unknown error occurred.");
                        fnBlockScreenGps("or An unknown error occurred.");
                        break;
                }
            });
        } else {
            $('#ui-block-text').offcanvas('hide');

            fnBlockScreenError("Error", "Something's not right. Geolocation is not supported by this browser.");
        }

    }

    function backToHome() {
        window.location.href = "@Url.Action("Index","Home")";
    }

    function openDeviceList() {
        $('#menu-device').offcanvas('show');
    }

    function clearSearch() {

        $('#homeInputSearchDevice').val("");

        $('#inputSearchId').val("");

        $('span#tagDeviceCountMobile').text(`N/A`);
        $('span#tagDeviceOnlineMobile').text(`N/A`);
        $('span#tagDeviceStartMobile').text(`N/A`);

        $('#tagAction').val(`ALL`);

        $('div #map div div img').removeClass('d-none')

        $('.pulsating-ringring').removeClass('pulsating-ringring');
        $('.pulsating-circle').removeClass('pulsating-circle');

        //map.zoom(4, true);

    }

    function writeTagAction(action) {
        $('#tagAction').val(`${action}`);

        if (action == 'ALL') {
            $('div#map div div img').removeClass('d-none');

            $('#txtSearchDevices').val("");

            $('#homeInputSearchDevice').css("color", "black");

            onFilter();
        }
        else if (action == 'GPS-ONLINE') {
            $('div#map div div img[gps="online"]').removeClass('d-none');
            $('div#map div div img[gps="offline"]').addClass('d-none');
        }
        else if (action == 'POWER-ON') {

            $('div#map div div img[working="true"]').removeClass('d-none');
            $('div#map div div img[working="false"]').addClass('d-none');
        }
        else {
            $('div#map div div img').removeClass('d-none');
        }

        /*getDeviceListOnMap();*/
    }

    function fnResetScreen() {
        location.reload();
    }


</script>


