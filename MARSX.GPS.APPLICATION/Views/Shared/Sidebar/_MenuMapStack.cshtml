<script>

    function onLoadMapCamera() {

    }

    function onSelectMapLayer(attr) {

        const currentLanguage = sessionStorage.getItem('currentLanguage');

        var currentId = attr.id;

        if (currentId == "road") {
            map.Layers.setBase(longdo.Layers.OSM);
        }
        else if (currentId == "grey") {
            map.Layers.setBase(longdo.Layers.GRAY);
        }
        else if (currentId == "dark") {
            map.enableFilter(longdo.Filter.Dark)
        }
        else if (currentId == "light") {
            map.enableFilter(longdo.Filter.Light)
        }

        else if (currentId == "thaichote") {
            map.Layers.setBase(longdo.Layers.THAICHOTE);
        }
        else if (currentId == "administrative-area") {
            map.Layers.setBase(longdo.Layers.POLITICAL);
        }
        else {
            map.Layers.setBase(longdo.Layers.EASY);
        }

    }

    function onSelectMapLayerWithLanguage(attr) {

        const currentLanguage = sessionStorage.getItem('currentLanguage');

        var currentId = attr.id;

        if (currentId == "road") {
            if (currentLanguage == 'th') {
                map.Layers.setBase(longdo.Layers.EASY);
            } else {
                map.Layers.setBase(longdo.Layers.EASY);
            }
        }
        else if (currentId == "grey") {
            if (currentLanguage == 'th') {
                map.Layers.setBase(longdo.Layers.GRAY);
            } else {
                map.Layers.setBase(longdo.Layers.GRAY_EN);
            }
        }
        else if (currentId == "dark") {
            map.enableFilter(longdo.Filter.Dark)
        }
        else if (currentId == "light") {
            map.enableFilter(longdo.Filter.Light)
        }

        else if (currentId == "thaichote") {
            map.Layers.setBase(longdo.Layers.THAICHOTE);
        }
        else if (currentId == "administrative-area") {
            if (currentLanguage == 'th') {
                map.Layers.setBase(longdo.Layers.POLITICAL);
            } else {
                map.Layers.setBase(longdo.Layers.POLITICAL_EN);
            }
        }
        else {
            if (currentLanguage == 'th') {
                map.Layers.setBase(longdo.Layers.EASY);
            } else {
                map.Layers.setBase(longdo.Layers.EASY);
            }
        }

    }</script>