@Html.Hidden("inputSearchId", "")

<!-- Main Sidebar-->
<div id="menu-device"
     data-menu-active="nav-homes"
     data-bs-backdrop="true"
     class="offcanvas offcanvas-start offcanvas-detached rounded-m">
    <div>
        <div class="card card-style mb-3 rounded-m mt-3" style="background-image: url(@Url.Content("~/customs/images/banner/marsxthings_01_25_2024-1.webp"))" data-card-height="150">
            <div class="card-top m-3">
                <div data-bs-dismiss="offcanvas" class="icon icon-xs bg-theme rounded-s color-theme float-end" role="button">
                    <i class="bi bi-caret-left-fill"></i>
                </div>
            </div>
            <div class="card-bottom p-3">
                <h1 class="color-white font-20 font-700 mb-n2">MARSTIAN</h1>
                <p class="color-white font-12 opacity-70 mb-n1">GPS TRACKING DEVICES</p>
            </div>
            <div class="card-overlay bg-gradient-fade rounded-0"></div>
        </div>

        <div class="px-2 ">
            <div class="form-custom form-label form-icon mb-3">
                <i class="bi bi-list font-14"></i>
                <input type="text" class="form-control rounded-l" id="txtSearchDevices" tabindex="1" autofocus placeholder="Search" style=" background-color: white;" onkeyup="onFilter()">
                <label for="txtSearchDevices" class="color-theme d-none">Your Name</label>
                <span class="font-18 pe-2" onclick="clearSearchDeviceList()">X</span>
            </div>
        </div>

    </div>
    <div id="deviceFovariteListZone">
        <span class="menu-divider">FAVORITE LIST</span>

        <div class="bg-theme mx-3 rounded-l shadow-m mt-3 mb-3" style="height: 15%;overflow: scroll;" id="deviceFovariteList">
        </div>
    </div>
    

    <span class="menu-divider">DEVICE LIST</span>

    <div class="bg-theme mx-3 rounded-l shadow-m mt-3 mb-3" style="height: 64%;overflow: scroll;" id="deviceList">
    </div>

</div>

<script type="text/javascript">

    document.addEventListener('DOMContentLoaded', function () {
        setTimeout(function () {

            document.getElementById("homeInputSearchDevice").addEventListener("click", function () {
                document.getElementById("txtSearchDevices").focus();
            });

            if (window.innerWidth < 768) {

                $('#menu-device').addClass("width-sidebar-device-70");
                $('#menu-device').removeClass("width-sidebar-device-desktop");
            }
            else {

                $('#menu-device').addClass("width-sidebar-device-desktop");
                $('#menu-device').removeClass("width-sidebar-device-70");

            }

        }, 1000);
    });

    function onFilter() {

        var textCurrent = $('#txtSearchDevices').val();

        var value = textCurrent.toLowerCase();

        $('div #map div div img').addClass('d-none')

        $("#deviceList #record").filter(function () {

            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)

            if ($(this).text().toLowerCase().indexOf(value) > -1) {

                var originalString = $(this).text().toLowerCase();

                originalString = originalString.trim();

                originalString = originalString.replace(/\s+/g, '');

                var startDelimiter = "[";
                var endDelimiter = "]";

                var startIndex = originalString.indexOf(startDelimiter);

                var endIndex = originalString.indexOf(endDelimiter);

                if (startIndex !== -1 && endIndex !== -1 && startIndex < endIndex) {
                    // Extract the substring between the delimiters
                    var extractedString = originalString.substring(startIndex + 1, endIndex);

                    var strArrayLatLon = extractedString.split(',');


                    $('img#' + strArrayLatLon[0]).removeClass('d-none')


                } else {
                    //console.log("Delimiters not found or in the wrong order.");
                }
            }
        });

        var getCurrentInfoDevice = $('#deviceList #record:not(:hidden) #setLocation');

        //console.log(getCurrentInfoDevice.text());

        var divHtml = getCurrentInfoDevice.text();

        $('#homeInputSearchDevice').val($('#txtSearchDevices').val());

    }

    function clearSearchDeviceList() {
        $('#txtSearchDevices').val("");

        onFilter();
    }


    function closeOffCanvasDeviceList() {

        $('#menu-device').offcanvas('hide');

        var getCurrentFilter = $('#txtSearchDevices').val();

        if (getCurrentFilter != "") {

            map.Overlays.clear();

            getDeviceListOnMap();

        }
        else {

        }
    }

    function getDeviceList() {
      
        $('#map-detail-canvas').offcanvas('hide');

        $('#device-detail-canvas').offcanvas('hide');

        $('#map-detail-canvas').css({ 'z-index': 1 });

        $('#device-detail-canvas').css({ 'z-index': 1 });

        $('#menu-device').offcanvas('show');

        $('#txtSearchDevices').val($('#homeInputSearchDevice').val());

        //map.zoom(4, true);

        if (window.innerWidth > 768) {

            $('.offcanvas-backdrop').css({
                opacity: 0,
                position: 'relative'
            })

            setTimeout(function () {
                $('#txtSearchDevices').focus();
            }, 1000);

            $('#menu-device').css({ 'z-index': 999 });

            $('#section-home-search').addClass('home-search-desktop');
            $('#section-home-search').removeClass('home-search-mobile');

            $('#section-home-search').removeClass('home-search');
        }
        else {

            $('.offcanvas-backdrop').remove()

            $('.offcanvas-backdrop').css({
                opacity: 0.5,
                position: 'absolute'
            })

            $('#menu-device').css({ 'z-index': 999 });
            $('#section-home-search').addClass('home-search-mobile');
            $('#section-home-search').removeClass('home-search-desktop');

            $('#section-home-search').removeClass('home-search');
        }

        onFilter();
       
    }


    function gotoLatLon(id, lon, lat, name) {

        if (lon != null && lon != "null" && lat != null && lat != "null") {
            var getCurrentName = decodeURIComponent(name);

            map.location({ lon: lon, lat: lat }, true);

            $('#homeInputSearchDevice').val(getCurrentName);

            $('#inputSearchId').val(id);

            $('div #map div div img').addClass('d-none')

            $('img#' + id).removeClass('d-none')

            updateId(id);

            $('#' + id).on('contextmenu', function (event) {
                event.preventDefault();

                $(this).trigger('click');
            });

            $('#' + id).trigger({
                type: 'contextmenu',
                which: 3
            });

            if (window.innerWidth <= 768) {
                $('#menu-device').offcanvas('hide');
            }
            else {
                $('#menu-device').offcanvas('show');
            }


            
        } else {
            blockScreenLocationNotfound("");
        }

        

    }

    function onfocusLatLon(id, lon, lat) {

        if (lon != null && lon != "null" && lat != null && lat != "null") {
            map.location({ lon: lon, lat: lat }, true);

            setTimeout(function () {
                // Your code here
                map.zoom(10, true);
            }, 1000); // 3000 milliseconds = 3 seconds

            if (window.innerWidth <= 768) {

                $('#' + id).on('contextmenu', function (event) {
                    event.preventDefault();

                    $(this).trigger('click');
                });

                $('#' + id).trigger({
                    type: 'contextmenu',
                    which: 3
                });

                $('#menu-device').offcanvas('hide');

            }

            $('.pulsating-ringring').removeClass('pulsating-ringring');
            $('.pulsating-circle').removeClass('pulsating-circle');


            $('#' + id + '-ringring').addClass('pulsating-ringring');
            $('#' + id + '-circle').addClass('pulsating-circle');
        } else {
            blockScreenLocationNotfound("");
        }

    }



    function verifyCategory(param) {

        /*icon example is https://tabler.io/icons*/

        var result = "";

        if (param == "car") {
            result = 'ti ti-truck';
        }

        else if (param == "crane") {
            result = 'ti ti-truck';
        }

        else if (param == "truck") {
            result = 'ti ti-truck';
        }

        else if (param == null || param == "") {
            result = 'ti ti-truck';
        }

        return result;

    }

    function verifyStatus(param) {

        var result = "";

        if (param != null) {
            if (param == "online") {
                result = 'bg-success p-1 text-white opacity-100';
            }

            else {
                result = 'bg-secondary p-1 text-white opacity-100';
            }
        }
        else {
            result = 'bg-secondary p-1 text-white opacity-100';
        }

        return result;
    }



    function verifyIsFavorite(id,isFavorite) {

        var result = `<i class="font-18 color-gray-dark px-1 bi bi-star-fill" id="device-favorite-${id}" attr-${id}-favorite="${isFavorite}"></i>`;

        if (isFavorite != null) {
            if (isFavorite == true) {
                result = `<i class="font-18 color-yellow-dark px-1 bi bi-star-fill" id="device-favorite-${id}" attr-${id}-favorite="${isFavorite}"></i>`;
            }

            else {
                result = `<i class="font-18 color-gray-dark px-1 bi bi-star-fill" id="device-favorite-${id}" attr-${id}-favorite="${isFavorite}"></i>`;
            }
        }
        else {
            result = `<i class="font-18 color-gray-dark px-1 bi bi-star-fill" id="device-favorite-${id}" attr-${id}-favorite="${isFavorite}"></i>`;
        }

        return result;
    }

    function verifyEngineDevice(param) {

        var result = "";

        if (param != null && param != "") {
            if (param == true) {
                result = 'ti ti-engine text-success';
            }

            else {
                result = 'ti ti-engine-off text-danger';
            }
        }
        else {
            result = 'ti ti-engine-off text-danger';
        }



        return result;
    }

    function verifyModel(param) {

        var result = "";

        if (param == null) {
            result = 'Data not found.';
        }

        else {
            result = param.trim();
        }

        return result;

    }

    function verifyImageDevice(param) {

        var result = "";

        if (param != null && param != "") {

            if (param.toLowerCase() == "car") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/car-wb.png")';

            }
            else if (param.toLowerCase() == "concrete machinery") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/cement-mixer-wb.png")';

            }
            else if (param.toLowerCase() == "crane") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/crane-wb.png")';

            }
            else if (param.toLowerCase() == "excavator") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/excavator-wb.png")';

            }
            else if (param.toLowerCase() == "hoisting machinery") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/hoisting-machinery-wb.png")';

            }
            else if (param.toLowerCase() == "mining machinery") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/mining-machinery-wb.png")';

            }
            else if (param.toLowerCase() == "mobile elevating work platform") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/mobile-elevating-work-platform-wb.png")';

            }
            else if (param.toLowerCase() == "other machinery") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/other-machinery-wb.png")';

            }
            else if (param.toLowerCase() == "piling machinery") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/piling-machinery-wb.png")';

            }
            else if (param.toLowerCase() == "port machinery") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/port-machinery-wb.png")';

            }
            else if (param.toLowerCase() == "road machinery") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/road-machinery-wb.png")';

            }
            else if (param.toLowerCase() == "truck") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/truck-wb.png")';

            }
            else if (param.toLowerCase() == "unknown") {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/question-wb.png")';

            }

            else {

                result = '@Url.Content("~/customs/icons/category-machine/white-black/question-wb.png")';

            }
        }

        else {
            result = '@Url.Content("~/customs/icons/category-machine/white-black/question-wb.png")';
        }

        return result;

    }


</script>

