@model MARSX.GPS.APPLICATION.Models.Customs.UserInfo

@{
    var setUsername = Model == null ? "N/A" : Model.UserName == null ? "N/A" : Model.UserName;
    var setEmail = Model == null ? "N/A" : Model.Email == null ? "N/A" : Model.Email;
}

<!-- Main Sidebar-->
<div id="menu-main"
     data-menu-active="nav-homes"
     style="width: 280px"
     class="offcanvas offcanvas-start offcanvas-detached rounded-m">

    <div class="card card-style mb-3 rounded-m mt-3" style="background-image: url(@Url.Content("~/customs/images/banner/banner-003.jpg"))" data-card-height="150">
        <div class="card-top m-3">
            <a href="#" data-bs-dismiss="offcanvas" class="icon icon-xs bg-theme rounded-s color-theme float-end"><i class="bi bi-caret-left-fill"></i></a>
        </div>
        <div class="card-bottom p-3">
            <h1 class="color-white font-20 font-700 mb-n2">MARSTIAN</h1>
            <p class="color-white font-12 opacity-70 mb-n1">GPS Tracking</p>
        </div>
        <div class="card-overlay bg-gradient-fade rounded-0"></div>
    </div>

    <div class="bg-theme mx-3 rounded-m shadow-m mt-3 mb-3">
        <div class="d-flex px-2 pb-2 pt-2">
            <div>
                <a href="#"><img src="@Url.Content("~/customs/icons/avatar/user-001.png")" width="45" class="rounded-s" alt="img"></a>
            </div>
            <div class="ps-2 align-self-center">
                <h5 class="ps-1 mb-0 line-height-xs pt-1">@setUsername</h5>
                <h6 class="ps-1 mb-0 font-400 opacity-40">@setEmail</h6>
            </div>
            <div class="ms-auto">
                <a href="#" data-bs-toggle="dropdown" class="icon icon-m ps-3"><i class="bi bi-three-dots-vertical font-18 color-theme"></i></a>
                <div class="dropdown-menu  bg-transparent border-0 mt-n1 ms-3">
                    <div class="card card-style rounded-m shadow-xl mt-1 me-1">
                        <div class="list-group list-custom list-group-s list-group-flush rounded-xs px-3 py-1">
                            <a href="#" class="color-theme opacity-70 list-group-item py-1"><strong class="font-500 font-12">Your Profile</strong><i class="bi bi-chevron-right"></i></a>
                            <a onclick="redirectToPage('Signout')" class="color-theme opacity-70 list-group-item py-1"><strong class="font-500 font-12">Log Out</strong><i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <span class="menu-divider">NAVIGATION</span>
    <div class="menu-list">
        <div class="card card-style rounded-m p-3 py-2 mb-3">
            <a onclick="redirectToPage('Home')" id="nav-homes" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-house-fill"></i>
                <span>Homepage</span>
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>

    <span class="menu-divider d-none">MANAGEMENT</span>
    <div class="menu-list d-none">
        <div class="card card-style rounded-m p-3 py-2 mb-0">
            <a onclick="redirectToPage('MasterDevice')" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Master devices</span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a onclick="redirectToPage('MasterDeviceStatus')" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Master device statuses</span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a onclick="redirectToPage('MasterDeviceGroup')" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Master device groups</span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a onclick="redirectToPage('MasterDeviceCategory')" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Master device category</span>
                <i class="bi bi-chevron-right"></i>
            </a>

            <a onclick="redirectToPage('MasterGpsProvider')" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Master gps provider</span>
                <i class="bi bi-chevron-right"></i>
            </a>

            <a onclick="redirectToPage('MasterGpsStatus')" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Master gps status</span>
                <i class="bi bi-chevron-right"></i>
            </a>





            <a onclick="redirectToPage('MasterAccount')" role="button">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Account</span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a>
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Permission individual</span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a>
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-files"></i>
                <span>Permission Group</span>
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>

    <span class="menu-divider mt-4">SETTINGS</span>
    <div class="menu-list">
        <div class="card card-style rounded-m p-3 py-2 mb-0">
            <a href="#" data-bs-toggle="offcanvas" data-bs-target="#menu-language">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-translate"></i>
                <span>Language</span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a href="#" class="d-none" data-bs-toggle="offcanvas" data-bs-target="#menu-color">
                <i class="gradient-orange shadow-bg shadow-bg-xs bi bi-palette-fill"></i>
                <span>Highlights</span>
                <i class="bi bi-chevron-right"></i>
            </a>
            <a href="#" data-toggle-theme data-trigger-switch="switch-1">
                <i class="gradient-dark shadow-bg shadow-bg-xs bi bi-moon-fill font-13"></i>
                <span>Dark Mode</span>
                <div class="form-switch ios-switch switch-green switch-s me-2">
                    <input type="checkbox" data-toggle-theme class="ios-input" id="switch-1">
                    <label class="custom-control-label" for="switch-1"></label>
                </div>
            </a>
        </div>
    </div>

    <br />

    <div class="menu-list">
        <div class="card card-style rounded-m p-3 py-2 mb-3">
            <a onclick="redirectToPage('Signout')" id="nav-homes" role="button">
                <i class="gradient-red shadow-bg shadow-bg-xs ti ti-lock"></i>
                <span>Lock Screen</span>
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>

    <p class="text-center mb-0 mt-n3 pb-3 font-9 text-uppercase font-600 color-theme">Made with <i class=" font-9 px-1 bi bi-heart-fill color-red-dark"></i> by MARSX THINGS CO., LTD. in <span class="copyright-year"></span>.</p>

    <p class="text-center mb-0 mt-n3 pb-3 font-9 text-uppercase font-600 color-theme">Online  <i class=" font-9 px-1 bi bi-person-circle color-green-dark"></i> <span id="user-online-count"></span></p>


</div>