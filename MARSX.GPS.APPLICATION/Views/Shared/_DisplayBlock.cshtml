<script>

    function blockScreenLocationNotfound() {

        $('#blockScreenLocationNotfound').offcanvas('show');
        
    }

    function fnBlockScreenGps(detail) {

        $('#blockScreenGps').offcanvas('show');
        $("block-screen-gps-detail").text(detail);
        $('#map-detail-canvas').offcanvas('hide');

    }

    function fnBlockScreenAccountBanned(detail) {

        $('#blockScreenAccountBanned').offcanvas('show');
        $("#block-screen-acount-bannd-detail").text(detail);

    }

    function fnBlockScreenError(header, content) {

        $('#blockScreenError').offcanvas('show');
        $('#block-screen-error-header').text(header);
        $('#block-screen-error-text').text(content);
        $('#map-detail-canvas').offcanvas('hide');

    }

    function fnBlockScreenWarning(header, content) {

        $('#blockScreenWarning').offcanvas('show');
        $('#block-screen-warning-header').text(header);
        $('#block-screen-warning-text').text(content);

    }

    function openBlockScreenLoading() {

        $('#block-screen-loading').offcanvas('show');

    }

    function closeBlockScreenLoading() {

        $('#block-screen-loading').offcanvas('hide');

    }</script>

<style>


    .loader-text{
      /*font-size: 48px;*/
      color: #FFF;
      display: inline-block;
      /*font-family: Arial, Helvetica, sans-serif;*/
