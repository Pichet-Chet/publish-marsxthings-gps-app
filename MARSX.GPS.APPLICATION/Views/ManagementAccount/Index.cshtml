@{
    ViewData["Title"] = "Management Account";
    ViewData["Name"] = "";
    ViewData["NameLower"] = "management account";
    Layout = "~/Views/Shared/_LayoutNoSideBar.cshtml";

}

@model MARSX.GPS.APPLICATION.Models.SysUser


@section Style {
    @await Html.PartialAsync("_Style")
}

<div class="header-bar header-fixed header-app header-bar-detached">
    <a onclick="redirectToPage('MasterAccount')" style="cursor:pointer"><i class="bi bi-caret-left-fill font-11 color-theme ps-2"></i></a>
    <a onclick="redirectToPage('MasterAccount')" style="cursor:pointer" class="header-title color-theme font-13">Back to Pages</a>
    <a href="#" data-bs-toggle="offcanvas" data-bs-target="#menu-language"><i class="bi bi-translate font-13 color-highlight"></i></a>
    <a data-bs-toggle="offcanvas" data-bs-target="#menu-color" href="#"><i class="bi bi-palette-fill font-13 color-highlight"></i></a>
    <a href="#" class="show-on-theme-light" data-toggle-theme><i class="bi bi-moon-fill font-13"></i></a>
    <a href="#" class="show-on-theme-dark" data-toggle-theme><i class="bi bi-lightbulb-fill color-yellow-dark font-13"></i></a>
</div>

@await Html.PartialAsync("_Content", Model)

@section Scripts {
    @await Html.PartialAsync("_Script", Model)
}