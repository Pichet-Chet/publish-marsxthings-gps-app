@Html.Hidden("inputId", "")

<!-- Footer Bar-->
<div onclick="openOffCanvas()" role="button" class="create-floating">
    <i class="ti ti-plus font-30"></i>
</div>


<div class="page-content header-clear-medium">

    <div class="card card-style">
        <div class="content">
            <h5 class="color-highlight font-13 mb-n1" translate="yes">Devices master</h5>
            <p class="mb-3 mt-3 font-13" translate="yes">
                Tap to item for setting device.
            </p>
            <div class="form-custom form-label form-icon mb-3 form-border">
                <i class="bi bi-search font-14"></i>
                <label for="txtSearch" class="color-theme d-none" translate="yes"></label>
                <input type="text" id="txtSearch" class="form-control rounded-xs" placeholder="" onkeyup="onFilter()">
            </div>
            <div class="list-group list-custom list-group-m rounded-m" id="renderDataList">

            </div>
        </div>
    </div>
</div>
<!-- End of Page Content-->


<div class="offcanvas offcanvas-bottom rounded-m offcanvas-detached bg-theme" id="canvas-form" style="height:80% !important">
    <div class="content">
        <div class="d-flex pb-2">
            <div class="align-self-center">
                <h5 class="mb-n2 font-12 color-highlight font-700 text-uppercase pt-1" translate="yes">MASTER DEVICES</h5>
                <h1 class="font-600 font-16 pt-2" translate="yes">CREATE RECORD</h1>
            </div>
            <div class="align-self-center ms-auto">
                <a href="#" data-bs-dismiss="offcanvas" class="icon icon-m"><i class="bi bi-x-circle-fill color-red-dark font-18 me-n4"></i></a>
            </div>
        </div>
        <div class="divider"></div>
        <form id="formSubmit" class="demo-animation needs-validation m-0" novalidate>

            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <input type="text" id="inputName" class="form-control rounded-xs" placeholder="Name" required />
                <label for="c1" class="color-theme" translate="yes">Name</label>
                <div class="invalid-feedback" translate="yes">
                    Please fill in the required fields.
                </div>
                <span translate="yes">(required)</span>
            </div>

            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <input type="text" id="inputUniqueId" class="form-control rounded-xs" placeholder="UniqueId" required />
                <label for="c1" class="color-theme">UniqueId</label>
                <div class="invalid-feedback" translate="yes">
                    Please fill in the required fields.
                </div>
                <span translate="yes">(required)</span>
            </div>

            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <select class="form-select rounded-xs" id="inputGroupId" required>
                    <option selected value="">-- Select machine group --</option>
                </select>
                <label for="c1" class="color-theme">GROUP</label>
                <div class="invalid-feedback" translate="yes">Please fill in the required fields.</div>
            </div>

            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <select class="form-select rounded-xs" id="inputCategoryId" required>
                    <option selected value="">-- Select machine category --</option>
                </select>
                <label for="c1" class="color-theme">CATEGORY</label>
                <div class="invalid-feedback" translate="yes">Please fill in the required fields.</div>
            </div>



            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <select class="form-select rounded-xs" id="inputStatusId" required>
                    <option selected value="">-- Select machine status --</option>
                </select>
                <label for="c1" class="color-theme">STATUS</label>
                <div class="invalid-feedback" translate="yes">Please fill in the required fields.</div>
            </div>


            @*<div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <select class="form-select rounded-xs" id="inputGpsStatusId" required>
                    <option selected value="">-- Select gps status --</option>
                </select>
                <label for="c1" class="color-theme">STATUS</label>
                <div class="invalid-feedback" translate="yes">Please fill in the required fields.</div>
            </div>*@



            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <input type="text" id="inputPhone" class="form-control rounded-xs" placeholder="Phone" onkeypress="return regNumberPhone(event)" />
                <label for="c1" class="color-theme">Phone</label>
                <div class="invalid-feedback" translate="yes">
                    Please fill in the required fields.
                </div>
                <span translate="yes">(required)</span>
            </div>

            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <input type="text" id="inputModel" class="form-control rounded-xs" placeholder="Model" />
                <label for="c1" class="color-theme">Model</label>
                <div class="invalid-feedback" translate="yes">
                    Please fill in the required fields.
                </div>
                <span translate="yes">(required)</span>
            </div>

            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <input type="text" id="inputContact" class="form-control rounded-xs" placeholder="Contact" />
                <label for="c1" class="color-theme">Contact</label>
                <div class="invalid-feedback" translate="yes">
                    Please fill in the required fields.
                </div>
                <span translate="yes">(optional)</span>
            </div>

            <div class="form-custom form-label form-border form-icon mb-3 bg-transparent">
                <i class="bi bi-pencil-square font-13"></i>
                <input type="text" id="inputDescription" class="form-control rounded-xs" placeholder="Description" />
                <label for="c1" class="color-theme" translate="yes">Description</label>
                <div class="invalid-feedback" translate="yes">
                    Please fill in the required fields.
                </div>
                <span translate="yes">(optional)</span>
            </div>

            <a href="#" class="d-flex pb-2" data-trigger-switch="switch-is-active">
                <div class="align-self-center">
                    <h6 class="mb-0 font-12">DISABLE / ENABLE</h6>
                </div>
                <div class="ms-auto align-self-center">
                    <div class="form-switch ios-switch switch-green switch-s">
                        <input type="checkbox" class="ios-input" id="switch-is-active" checked>
                        <label class="custom-control-label" for="switch-is-active"></label>
                    </div>
                </div>
            </a>

            <button class="save-floating" type="submit" translate="yes">
                <i class="ti ti-device-floppy font-30"></i>
            </button>
        </form>
    </div>
</div>